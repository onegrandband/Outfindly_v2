rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check & connection validation endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSavedAvatar(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'fileName', 'fileType', 'fileSize', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'description', 'fileName', 'fileType', 'fileSize', 'category', 'dataUrl', 'tags', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 200
        && data.fileType is string && data.fileType.size() <= 100
        && data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 10485760
        && data.category is string && data.category.size() <= 50
        && (!('dataUrl' in data) || (data.dataUrl is string && data.dataUrl.size() <= 1048576))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Saved avatars collection partitioned per user
    match /users/{userId}/saved_avatars/{avatarId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow delete: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidId(avatarId)
        && isValidSavedAvatar(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(avatarId)
        && isValidSavedAvatar(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }
  }
}
